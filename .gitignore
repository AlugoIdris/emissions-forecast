# ── Data ────────────────────────────────────────────────────────────────────
# Raw / large data files are excluded, but the anonymised dataset is tracked
*.xlsx
*.parquet
*.feather
*.h5
*.hdf5
# Allow the anonymised input dataset
!data/esgdata.csv

# ── Figures & results (auto-generated) ──────────────────────────────────────
figures/
results/
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.whl
MANIFEST

# ── Environments ────────────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
.conda/
*.env

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.nbconvert.*
profile_default/
ipython_config.py

# ── Model artefacts & checkpoints ───────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.joblib
checkpoints/
lightning_logs/

